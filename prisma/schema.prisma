generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  hashedPassword String?
  role             String        @default("CLIENT") // ADMIN | CLIENT
  language         String        @default("en")     // nl | fi | en
  resetToken       String?       @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime      @default(now())

  trialEndsAt          DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String    @default("TRIALING") // TRIALING | ACTIVE | PAST_DUE | CANCELED | EXPIRED
  // Trial days still remaining at the moment they subscribed, honored as extra
  // days added to the first billing period's displayed countdown. Stripe's
  // actual charge/renewal cadence is untouched — this is display-only.
  subscriptionBonusDays Int      @default(0)

  teamMemberships TeamMember[]
  sentMessages    ChatMessage[]
  supportTickets  SupportTicket[]
  feedbacks       Feedback[]
}

model Workspace {
  id             String   @id @default(uuid())
  domain         String   @unique
  websiteName    String
  description    String   @db.Text
  niche          String?
  country        String?
  language           String?
  monthlyTraffic     Int?
  verificationStatus String    @default("UNVERIFIED") // VERIFIED | FLAGGED | UNVERIFIED | FAILED
  detectedLanguage   String?
  hreflangTags       String?
  lastVerifiedAt     DateTime?
  verificationNotes  String?    @db.Text
  createdAt          DateTime  @default(now())

  teamMembers            TeamMember[]
  giverThreads           ExchangeThread[] @relation("GiverWorkspace")
  receiverThreads        ExchangeThread[] @relation("ReceiverWorkspace")
  giverLinkPlacements    LinkPlacement[]  @relation("GiverLinkPlacements")
  receiverLinkPlacements LinkPlacement[]  @relation("ReceiverLinkPlacements")
  notifications          Notification[]
}

model TeamMember {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  role        String    // OWNER | EDITOR | VIEWER

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model ExchangeThread {
  id                  String    @id @default(uuid())
  giverWorkspaceId    String
  receiverWorkspaceId String
  stage               String    @default("NEW")   // NEW | CHAT | PLACED
  status              String    @default("PENDING") // PENDING | ACCEPTED | REJECTED
  giverAccepted       Boolean   @default(false)
  receiverAccepted    Boolean   @default(false)
  rejectedByWorkspaceId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  giverWorkspace      Workspace     @relation("GiverWorkspace", fields: [giverWorkspaceId], references: [id])
  receiverWorkspace   Workspace     @relation("ReceiverWorkspace", fields: [receiverWorkspaceId], references: [id])
  messages            ChatMessage[]
  linkPlacement       LinkPlacement?
}

model ChatMessage {
  id           String   @id @default(uuid())
  threadId     String
  senderUserId String
  messageText  String   @db.Text
  timestamp    DateTime @default(now())

  thread       ExchangeThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender       User           @relation(fields: [senderUserId], references: [id])
}

model LinkPlacement {
  id                  String    @id @default(uuid())
  threadId            String?   @unique
  giverWorkspaceId    String
  receiverWorkspaceId String
  sourceUrl           String     @db.Text
  targetUrl           String     @db.Text
  anchorText          String
  linkType            String    // GUEST_POST | NICHE_EDIT | IMAGE | OTHER
  status              String    @default("LIVE") // LIVE | REMOVED | DEPARTED
  datePlaced          DateTime  @default(now())

  thread              ExchangeThread? @relation(fields: [threadId], references: [id])
  giverWorkspace      Workspace       @relation("GiverLinkPlacements", fields: [giverWorkspaceId], references: [id])
  receiverWorkspace   Workspace       @relation("ReceiverLinkPlacements", fields: [receiverWorkspaceId], references: [id])
}

model AdminNotification {
  id          String   @id @default(uuid())
  title       String      @db.Text
  description String      @db.Text
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  workspaceId String
  type        String
  title       String?     @db.Text
  body        String?     @db.Text
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  payload     String?     @db.Text  

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  message   String   @db.Text
  status    String   @default("OPEN") // OPEN | RESOLVED
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSettings {
  id                   String   @id @default("singleton")
  cronExpression       String   @default("*/10 * * * *")
  matchAmount          Int      @default(2)
  rejectLimit          Int      @default(5)
  answerTimeoutDays    Int      @default(7)
  placementTimeoutDays Int      @default(30)
  // BETA: no payment/trial gating, full access for everyone. PAID: normal
  // trial + Stripe subscription gating applies.
  platformMode         String   @default("BETA") // BETA | PAID
  updatedAt            DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  topic     String
  message   String   @db.Text
  rating    Int
  recommend String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Blog ─────────────────────────────────────────────────────────────────

model BlogCategory {
  id        String     @id @default(uuid())
  slug      String     @unique
  name      String
  h1        String     @default("")
  intro     String     @db.Text
  sortOrder Int        @default(0)
  posts     BlogPost[]
}

model BlogAuthor {
  id          String     @id @default(uuid())
  slug        String     @unique
  name        String
  role        String     @default("")
  bio         String     @db.Text
  avatarUrl   String?    @db.VarChar(1000)
  linkedinUrl String?    @db.VarChar(1000)
  sortOrder   Int        @default(0)
  posts       BlogPost[] @relation("PostAuthor")
  reviewed    BlogPost[] @relation("PostReviewer")
}

model BlogPost {
  id             String        @id @default(uuid())
  slug           String        @unique
  status         String        @default("DRAFT") // DRAFT | PUBLISHED
  featured       Boolean       @default(false)
  title          String        @db.VarChar(300)
  excerpt        String        @db.Text
  description    String        @db.Text // dek under the H1, also the meta description fallback
  seoTitle       String?       @db.VarChar(300)
  seoDescription String?       @db.Text
  coverImage     String?       @db.VarChar(1000)
  coverAlt       String?       @db.VarChar(500)
  coverCaption   String?       @db.Text
  customCss      String?       @db.Text // extra CSS for this post's page
  jsonLd         String?       @db.Text // extra structured data (JSON) added to the page
  readMinutes    Int?
  takeaways      Json          // string[]
  body           Json          // Block[]
  faqs           Json          // [question, answer][]
  sources        Json          // { label, href }[]
  tags           Json          // string[]
  categoryId     String?
  authorId       String?
  reviewerId     String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category       BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author         BlogAuthor?   @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewer       BlogAuthor?   @relation("PostReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

model BlogMedia {
  id        String   @id @default(uuid())
  url       String   @db.VarChar(1000)
  key       String?  @db.VarChar(500) // S3 object key, or "local:<file>" in development
  filename  String
  mimeType  String
  size      Int
  alt       String   @default("")
  createdAt DateTime @default(now())
}

model BlogSettings {
  id              String   @id @default("singleton")
  eyebrow         String   @default("SERPsupport blog")
  h1              String   @default("Link building, explained by people who do it daily.")
  intro           String   @db.Text
  seoTitle        String   @default("SERPsupport Blog — Link building guides, guest posting & SEO")
  seoDescription  String   @db.Text
  pillarsTitle    String   @default("Pillar guides")
  pillarsText     String   @default("Long-form guides that every article in the category links back to.")
  pillars         Json     // { title, href }[]
  ctaTitle        String   @default("Build links without the swap trail.")
  ctaText         String   @default("Chat with site owners and approve every placement. 7-day free trial.")
  ctaButton       String   @default("Create account →")
  newsletterTitle String   @default("One link building idea, every other Tuesday.")
  newsletterText  String   @default("New guides and placement data from the SERPsupport network. No spam, unsubscribe anytime.")
  customCss       String?  @db.Text // CSS added to every blog page
  updatedAt       DateTime @updatedAt
}
